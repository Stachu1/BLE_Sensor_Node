# KiCad .gitignore - ignore backups, caches and generated outputs

# Editor / OS
*~
**/*.swp
**/*.tmp
**/*.bak
**/*.orig
**/*.rej
.DS_Store
Thumbs.db

# KiCad backups / autosaves
**/*.kicad_pcb-bak
**/*.kicad_pcb-bck
**/*.kicad_sch-bak
**/*.kicad_sch-bck
**/*.sch~
**/*.kicad_sch~
**/*.autosave
**/~*.lck

# KiCad cache / library local files (can be regenerated)
**/fp-cache/
**/fp-info-cache
**/sym_cache/
**/*.kicad_prl
**/cache/

# Fabrication / generated outputs
gerbers/
fab/
plots/
export/
pnp/
mfg/
**/*.gbr
**/*.drl
**/*.drls
**/*.pos
**/*.zip

# C files
**/*.o
**/*.elf
**/*.bin
**/*build



docs/private/

# Vendor datasheets: kept locally, listed with links in docs/datasheets/README.md
docs/datasheets/**/*.pdf

# Python
**/__pycache__/
*.pyc

# Interactive HTML BOM (generate locally with the InteractiveHtmlBom plugin)
**/ibom.html
